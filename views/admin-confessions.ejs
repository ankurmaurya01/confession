<%- include('partials/header', { title: 'Moderate Confessions' }) %>

<div class="space-y-6">
  <!-- Nav header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-700">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-800 dark:text-white">Confession Moderation</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">Review pending submissions, inspect reports, and view real authors</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="/admin" class="px-3.5 py-1.5 border border-slate-300 dark:border-slate-600 rounded-xl text-xs font-semibold hover:bg-slate-100 dark:hover:bg-slate-700 transition">
        &larr; Dashboard
      </a>
      <a href="/admin/users" class="px-3.5 py-1.5 bg-slate-700 text-white rounded-xl text-xs font-semibold hover:bg-slate-800 transition">
        Manage Users
      </a>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-3.5 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 rounded-xl text-sm">
      <%= success %>
    </div>
  <% } %>

  <!-- Tab Buttons -->
  <div class="flex items-center gap-2 border-b border-slate-200 dark:border-slate-700 pb-2">
    <a href="/admin/confessions?tab=pending"
      class="px-4 py-2 rounded-xl text-xs font-bold transition <%= currentTab === 'pending' ? 'bg-amber-600 text-white shadow-sm' : 'bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700' %>">
      Pending Moderation
    </a>
    <a href="/admin/confessions?tab=reported"
      class="px-4 py-2 rounded-xl text-xs font-bold transition <%= currentTab === 'reported' ? 'bg-red-600 text-white shadow-sm' : 'bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700' %>">
      Reported by Students
    </a>
    <a href="/admin/confessions?tab=approved"
      class="px-4 py-2 rounded-xl text-xs font-bold transition <%= currentTab === 'approved' ? 'bg-emerald-600 text-white shadow-sm' : 'bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700' %>">
      Live / Approved
    </a>
    <a href="/admin/confessions?tab=rejected"
      class="px-4 py-2 rounded-xl text-xs font-bold transition <%= currentTab === 'rejected' ? 'bg-slate-600 text-white shadow-sm' : 'bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700' %>">
      Rejected
    </a>
  </div>

  <!-- Confessions List -->
  <div class="space-y-4">
    <% if (confessions && confessions.length > 0) { %>
      <% confessions.forEach(item => { %>
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
          <!-- Author banner & Status -->
          <div class="flex flex-wrap items-center justify-between gap-3 text-xs bg-slate-50 dark:bg-slate-700/50 p-3 rounded-xl border border-slate-200 dark:border-slate-700">
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-bold uppercase text-[10px] px-2 py-0.5 rounded bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300">
                <%= item.category %>
              </span>

              <span class="text-slate-400">|</span>

              <span class="font-semibold text-slate-800 dark:text-slate-100">
                Real Author:
                <% if (item.author) { %>
                  <span class="text-blue-600 dark:text-blue-400 font-bold"><%= item.author.name %></span>
                  (@<%= item.author.username %> • <%= item.author.email %> • <%= item.author.mobile %>)
                  <% if (item.author.isBanned) { %>
                    <span class="px-1.5 py-0.2 bg-red-100 text-red-700 rounded text-[10px] font-bold">AUTHOR BANNED</span>
                  <% } %>
                <% } else { %>
                  <span class="text-slate-400 italic">User deleted or unknown</span>
                <% } %>
              </span>
            </div>

            <div class="flex items-center gap-2">
              <span class="text-slate-400">Status: <strong class="uppercase text-slate-700 dark:text-slate-200"><%= item.status %></strong></span>
              <% if (item.reports && item.reports.length > 0) { %>
                <span class="px-2 py-0.5 rounded bg-red-100 dark:bg-red-950 text-red-700 dark:text-red-300 font-bold">
                  <%= item.reports.length %> Reports
                </span>
              <% } %>
            </div>
          </div>

          <!-- Confession Content -->
          <p class="text-slate-800 dark:text-slate-100 text-base leading-relaxed whitespace-pre-wrap">
            <%= item.content %>
          </p>

          <!-- Moderation Actions Toolbar -->
          <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-slate-100 dark:border-slate-700/60 text-xs">
            <div class="text-slate-400">
              Submitted: <%= new Date(item.createdAt).toLocaleString('en-IN') %>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <% if (item.status !== 'approved') { %>
                <form action="/admin/confessions/<%= item._id %>/approve" method="POST" class="inline">
                  <button type="submit" class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-semibold transition">
                    Approve
                  </button>
                </form>
              <% } %>

              <% if (item.status !== 'rejected') { %>
                <form action="/admin/confessions/<%= item._id %>/reject" method="POST" class="inline">
                  <button type="submit" class="px-3.5 py-1.5 bg-amber-600 hover:bg-amber-700 text-white rounded-lg font-semibold transition">
                    Reject
                  </button>
                </form>
              <% } %>

              <!-- Quick Ban Author Button -->
              <% if (item.author && !item.author.isBanned && item.author.role !== 'admin') { %>
                <form action="/admin/users/<%= item.author._id %>/ban" method="POST" class="inline"
                      onsubmit="const reason = prompt('Ban author <%= item.author.username %>? Enter reason:'); if (!reason) return false; this.reason.value = reason;">
                  <input type="hidden" name="reason" value="">
                  <button type="submit" class="px-3.5 py-1.5 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-semibold transition">
                    Ban Author
                  </button>
                </form>
              <% } %>

              <form action="/admin/confessions/<%= item._id %>/delete" method="POST" class="inline" onsubmit="return confirm('Permanently delete this confession?');">
                <button type="submit" class="px-3.5 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded-lg font-semibold transition">
                  Delete
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="text-center py-16 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700">
        <p class="text-3xl mb-2">✨</p>
        <p class="text-base font-bold text-slate-800 dark:text-white">No confessions found in "<%= currentTab %>"</p>
        <p class="text-xs text-slate-400 mt-1">Check back later or view another moderation tab.</p>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
