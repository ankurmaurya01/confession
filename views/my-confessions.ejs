<%- include('partials/header', { title: 'My Confessions' }) %>

<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-700">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-800 dark:text-white">My Confessions</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">Track moderation status and manage your anonymous submissions</p>
    </div>
    <a href="/" class="text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline">
      + Post New
    </a>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 rounded-2xl text-sm">
      <%= success %>
    </div>
  <% } %>

  <div class="space-y-4">
    <% if (confessions && confessions.length > 0) { %>
      <% confessions.forEach(item => { %>
        <article class="bg-white dark:bg-slate-800 p-5 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300">
                <%= item.category %>
              </span>

              <!-- Status Badge -->
              <% if (item.status === 'approved') { %>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300">
                  Approved & Public
                </span>
              <% } else if (item.status === 'pending') { %>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-300">
                  Under Moderation Review
                </span>
              <% } else { %>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-red-100 dark:bg-red-950 text-red-700 dark:text-red-300">
                  Rejected by Admin
                </span>
              <% } %>

              <% if (item.isReportHidden) { %>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-rose-100 dark:bg-rose-950 text-rose-700 dark:text-rose-300">
                  Auto-hidden (Reported)
                </span>
              <% } %>
            </div>

            <time class="text-xs text-slate-400">
              <%= new Date(item.createdAt).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
            </time>
          </div>

          <p class="text-slate-800 dark:text-slate-200 text-sm whitespace-pre-wrap leading-relaxed">
            <%= item.content %>
          </p>

          <div class="flex items-center justify-between pt-3 border-t border-slate-100 dark:border-slate-700/60 text-xs">
            <span class="text-slate-500">❤️ <%= (item.likes && item.likes.length) || 0 %> Likes</span>

            <!-- Delete Button -->
            <form action="/my-confessions/<%= item._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this confession permanently?');">
              <button type="submit"
                class="text-red-600 dark:text-red-400 hover:text-red-700 font-semibold hover:bg-red-50 dark:hover:bg-red-950/40 px-3 py-1.5 rounded-lg transition">
                Delete Confession
              </button>
            </form>
          </div>
        </article>
      <% }) %>
    <% } else { %>
      <div class="text-center py-16 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700">
        <p class="text-4xl mb-3">✍️</p>
        <h3 class="text-lg font-bold text-slate-800 dark:text-white">You haven't posted any confessions</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Ready to share something anonymously?</p>
        <a href="/" class="mt-4 inline-block px-4 py-2 bg-blue-600 text-white rounded-xl text-xs font-semibold hover:bg-blue-700 transition">
          Go to Feed to Post
        </a>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
