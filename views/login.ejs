<%- include('partials/header', { title: 'Log In' }) %>

<div class="max-w-md mx-auto bg-white dark:bg-slate-800 p-8 rounded-2xl shadow-md border border-slate-200 dark:border-slate-700 my-8">
  <div class="text-center mb-6">
    <h1 class="text-2xl font-extrabold text-slate-800 dark:text-white">Welcome Back</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Log in to post confessions or view your account</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-5 p-3.5 bg-red-50 dark:bg-red-950/50 border border-red-300 dark:border-red-800 text-red-700 dark:text-red-300 rounded-xl text-sm flex items-center gap-2">
      <svg class="w-5 h-5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
      </svg>
      <span><%= error %></span>
    </div>
  <% } %>

  <form action="/login" method="POST" class="space-y-4">
    <div>
      <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1">Email or Username</label>
      <input type="text" name="loginId" required placeholder="username or email"
        class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1">Password</label>
      <input type="password" name="password" required placeholder="••••••••"
        class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
    </div>

    <button type="submit"
      class="w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl shadow-sm transition mt-2">
      Log In
    </button>
  </form>

  <p class="text-center text-xs text-slate-500 dark:text-slate-400 mt-6">
    New to GL Bajaj Confessions?
    <a href="/signup" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">Create an account</a>
  </p>
</div>

<%- include('partials/footer') %>
